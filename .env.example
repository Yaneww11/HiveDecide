# Copy to .env and set a real DJANGO_SECRET_KEY. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Read by Django and by docker-compose.yml.
POSTGRES_DB=hive_decide
POSTGRES_USER=hive_decide
POSTGRES_PASSWORD=hive_decide
POSTGRES_HOST=localhost
# Host port; 5433 avoids a clash with a locally installed PostgreSQL.
POSTGRES_PORT=5433
